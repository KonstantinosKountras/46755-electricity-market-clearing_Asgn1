# =========================
# Project-specific ignores
# =========================

# Ignore large raw data
0_Init_Data/

# Ignore documents
*.pdf
*.docx
*.url
*.zip

# =========================
# Python standard ignores
# =========================

# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Jupyter Notebook
.ipynb_checkpoints/

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Coverage & testing
.coverage
.coverage.*
.pytest_cache/

# VS Code (optional)
.vscode/
